# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Nothing here is required. With no .env at all the system runs on a
# pattern-backed model: every stage, the gate, the API and the MCP server all
# work, and the tests pass.

# Which language model reads the documents.
#   fake    patterns, no network. The default.
#   gemini  Google AI Studio. Free tier, no card.
#   groq    Groq. Free tier, no card.
# LLM_PROVIDER=fake
# LLM_API_KEY=your-key-here
# Leave blank to use the cheapest model the provider offers that answers in
# JSON: gemini-3.5-flash-lite, or openai/gpt-oss-120b on Groq.
# LLM_MODEL=

# Where run state is kept when using SQLite.
# CHECKPOINT_PATH=runs.db

# Folders the system reads.
# CORPUS_DIR=corpus
# INBOX_DIR=inbox
# RULES_PATH=corpus/rules/vendor-billing-checklist.yaml
